# LegalMind AI Environment Configuration
# Copy this file to .env and populate with your credentials.

# ---------------------------------------------------------
# DGX Backend Configuration (College Credentials)
# ---------------------------------------------------------
DGX_HOST=aicentre.sece.ac.in
DGX_PORT=22
DGX_USERNAME=your_new_username
DGX_PASSWORD=your_new_password

# ---------------------------------------------------------
# LegalMind AI Application Configuration
# ---------------------------------------------------------
# The threshold below which the model will abstain due to insufficient evidence (0.0 to 1.0)
LEGALMIND_ABSTAIN_FLOOR=0.05

# Database paths
LEGALMIND_DB_PATH=./data/legalmind.db
LEGALMIND_AUTHORITY_DB=./data/verification/authorities.db

# Model configuration
MODEL_NAME=Qwen/Qwen3.6-35B-A3B
MODEL_ENDPOINT=local

# ---------------------------------------------------------
# Third Party APIs
# ---------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
